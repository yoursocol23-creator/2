UI:SetupAIWheelScroll()

UI.renderConnection = RunService.RenderStepped:Connect(function(dt)
    if not UI.isRunning then
        return
    end

    pcall(function()
        UI:UpdateRobloxInputCapture()
    end)

    if not UI.isBooting then
        pcall(function()
            UI:HandleHotkeys()
        end)

        pcall(function()
            UI:UpdateRobloxInputCapture()
        end)

        if not UI.uiVisible then
            pcall(function()
                UI:RefreshHomeStats(false)
            end)

            pcall(function()
                UI:UpdateAIRequestTimeout()
            end)

            pcall(function()
                UI:UpdateAIPolling()
            end)

            pcall(function()
                UI:RefreshEspEnabledState()
                if UI.espEnabledState.npcPlayer or UI.espEnabledState.npcBeast or next(UI.activeEspKeys.npc) ~= nil then
                    UI:UpdateNpcEsp()
                end
                if UI.espEnabledState.pc or next(UI.activeEspKeys.pc) ~= nil then
                    UI:UpdateComputerEsp()
                end
                if UI.espEnabledState.fp or next(UI.activeEspKeys.fp) ~= nil then
                    UI:UpdateFreezePodEsp()
                end
                if UI.espEnabledState.ed or next(UI.activeEspKeys.ed) ~= nil then
                    UI:UpdateExitDoorEsp()
                end
                UI:UpdateBeastMovement()
            end)

            if not UI.hiddenCleared then
                UI:ClearAllBuckets()
                UI.hiddenCleared = true
            end
            UI.animationsActive = false
            UI.needsRedraw = false
            pcall(function()
                UI:DebugPerfReport(false)
            end)
            return
        end

        UI.hiddenCleared = false
    end

    UI:UpdateRainbowAccent()

    if UI.isBooting then
        local oldReady = UI.bootReady == true

        pcall(function()
            if not UI:AreUIImagesDisabled() then
                UI:GetLogoImageData()
            end
            UI:GetLoadingLogoImageData()
            UI:GetLoadingSpinnerImageData()
        end)

        UI:UpdateLoadingAnimation(dt or (1 / 60))

        if (tick() - UI.bootStartedAt) >= UI.bootDuration
            and (UI.bootVisualProgress or 0) >= 0.999
            and UI:IsLogoImageReady()
            and UI:IsLoadingAssetsReady()
        then
            UI.bootReady = true
        end

        if UI.bootReady then
            UI.bootReadyAt = UI.bootReadyAt or tick()

            if tick() - UI.bootReadyAt >= 0.45 then
                UI.isBooting = false
                UI.bootReady = false

                if UI:AreAnimationsEnabled() then
                    UI.uiAlpha = 0
                    UI.renderScale = 0.82
                    UI.contentAlpha = 0
                    UI.contentOffset = 4
                else
                    UI.uiAlpha = 1
                    UI.renderScale = 1
                    UI.contentAlpha = 1
                    UI.contentOffset = 0
                end

                UI.needsRedraw = true
            end
        end

        local now = tick()
        if (now - (UI.lastLoadingRedraw or 0)) >= (1 / 30)
            or (UI.bootReady == true) ~= oldReady
        then
            UI.lastLoadingRedraw = now
            UI.needsRedraw = true
        end
    end

    local inputChanged = false
    local activeInteraction = false

    if not UI.isBooting then
        pcall(function()
            inputChanged = UI:PollFrameInputChanged()
        end)

        pcall(function()
            UI:RefreshHomeStats(false)
        end)

        if UI.selectedTab == (UI.statsTabIndex or 5) then
            pcall(function()
                UI:RefreshStatsTab(false)
            end)
        end

        pcall(function()
            UI:UpdateAIRequestTimeout()
        end)

        pcall(function()
            UI:UpdateAIPolling()
        end)

        pcall(function()
            UI:RefreshEspEnabledState()
            if UI.espEnabledState.npcPlayer or UI.espEnabledState.npcBeast or next(UI.activeEspKeys.npc) ~= nil then
                UI:UpdateNpcEsp()
            end
            if UI.espEnabledState.pc or next(UI.activeEspKeys.pc) ~= nil then
                UI:UpdateComputerEsp()
            end
            if UI.espEnabledState.fp or next(UI.activeEspKeys.fp) ~= nil then
                UI:UpdateFreezePodEsp()
            end
            if UI.espEnabledState.ed or next(UI.activeEspKeys.ed) ~= nil then
                UI:UpdateExitDoorEsp()
            end
            UI:UpdateBeastMovement()
        end)

        activeInteraction = UI:HasActiveInteraction()
    end

    if UI.isBooting or UI.needsRedraw or UI.animationsActive or inputChanged or activeInteraction then
        pcall(function()
            UI:UpdateAnimations(dt or (1 / 60))
        end)
    end

    if UI.searchFocused or UI.activeTextInput or UI.activeDropdownSearch then
        pcall(function()
            UI:PollSearchKeys()
        end)
    end

    if UI.activeKeybind then
        pcall(function()
            UI:PollKeybindCapture()
        end)
    end

    if not UI.isBooting then
        pcall(function()
            UI:HandleInput()
        end)

        pcall(function()
            UI:HandleTransientEffects()
        end)
    end

    if UI.isBooting or UI.needsRedraw or UI.animationsActive or inputChanged or activeInteraction then
        pcall(function()
            UI:Render()
        end)
    end

    pcall(function()
        UI:DebugPerfReport(false)
    end)
end)


