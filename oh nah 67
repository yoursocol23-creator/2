function UI:SetLocalWalkSpeed(speed)
    local character = LocalPlayer and LocalPlayer.Character
    if not character then
        self.lastAppliedWalkSpeed = nil
        return
    end

    local hum = character:FindFirstChild("Humanoid")
    if not hum or not hum.Address or type(memory_write) ~= "function" then
        self.lastAppliedWalkSpeed = nil
        return
    end

    pcall(memory_write, "float", hum.Address + 0x1d0, speed)
    pcall(memory_write, "float", hum.Address + 0x3bc, speed)
    self.lastAppliedWalkSpeed = speed
end

function UI:UpdateBeastMovement()
    local VK_Q = 0x51
    local beastTab = self.beastTabIndex or 4
    local noJumpSlowdown = self:GetControl(beastTab, "no_jump_slowdown")
    local noCooldownRunner = self:GetControl(beastTab, "no_cooldown_runner")
    local jumpSlowdownEnabled = noJumpSlowdown and self:GetControlRawValue(noJumpSlowdown, false) == true
    local runnerCooldownEnabled = noCooldownRunner and self:GetControlRawValue(noCooldownRunner, false) == true

    if self:IsLocalPlayerCrawling() then
        self:SetLocalWalkSpeed(7)
        return
    end

    if not jumpSlowdownEnabled and not runnerCooldownEnabled then
        self:SetLocalWalkSpeed(16)
        return
    end

    local humanoid = self:GetLocalHumanoid()
    if not humanoid then
        self.lastAppliedWalkSpeed = nil
        return
    end

    local qPressed = false
    if runnerCooldownEnabled and type(iskeypressed) == "function" then
        local ok, pressed = pcall(iskeypressed, VK_Q)
        qPressed = ok and pressed == true
    end

    if runnerCooldownEnabled and qPressed then
        self:SetLocalWalkSpeed(24)
        return
    end

    if jumpSlowdownEnabled then
        self:SetLocalWalkSpeed(17)
        return
    end

    self:SetLocalWalkSpeed(16)
end

