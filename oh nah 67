function UI:RefreshStatsTab(force)
    local now = tick()
    if not force and (now - (self.lastStatsTabRefresh or 0)) < 0.35 then
        return
    end

    self.lastStatsTabRefresh = now

    local statsTab = self.statsTabIndex or 5
    local dropdown = self:GetControl(statsTab, "stats_player_select")
    if not dropdown then
        return
    end

    local playerNames = {}
    for _, player in ipairs(Players:GetPlayers()) do
        table.insert(playerNames, player.Name)
    end

    table.sort(playerNames, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    dropdown.options = playerNames

    local selectedName = tostring(self:GetControlRawValue(dropdown, "") or "")
    local selectionValid = false
    for _, playerName in ipairs(playerNames) do
        if playerName == selectedName then
            selectionValid = true
            break
        end
    end

    if not selectionValid then
        local defaultName = ""
        if LocalPlayer and table.find(playerNames, LocalPlayer.Name) then
            defaultName = LocalPlayer.Name
        else
            defaultName = playerNames[1] or ""
        end
        self:SetControlRawValue(dropdown, defaultName)
        selectedName = defaultName
    end

    local selectedPlayer = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name == selectedName then
            selectedPlayer = player
            break
        end
    end

    local builtControls = {dropdown}

    local statsModule = selectedPlayer and selectedPlayer:FindFirstChild("SavedPlayerStatsModule") or nil
    if statsModule then
        local children = statsModule:GetChildren()
        table.sort(children, function(a, b)
            return string.lower(a.Name) < string.lower(b.Name)
        end)

        for _, child in ipairs(children) do
            table.insert(builtControls, {
                id = "saved_stats_" .. child.Name,
                type = "stat",
                label = child.Name,
                value = self:FormatSavedPlayerStatValue(child),
                group = "Saved Stats",
                side = 1,
            })
        end
    else
        table.insert(builtControls, {
            id = "saved_stats_status",
            type = "stat",
            label = "Status",
            value = selectedPlayer and "No SavedPlayerStatsModule" or "No player selected",
            group = "Saved Stats",
            side = 1,
        })
    end

    self.statsTabControls = builtControls
    self:MarkTabDirty(statsTab)
end

