function UI:GetPrimitivePointerOffset(part, primitivePositionOffset)
    if not part or not part.Address or type(memory_read) ~= "function" or type(primitivePositionOffset) ~= "number" then
        return nil
    end

    for offset = 8, 1024, 8 do
        local readPtrSuccess, ptrAddress = pcall(memory_read, "uintptr_t", part.Address + offset)
        if readPtrSuccess and ptrAddress and ptrAddress > 10000 then
            local readPosSuccess, memPosX = pcall(memory_read, "float", ptrAddress + primitivePositionOffset)
            if readPosSuccess and type(memPosX) == "number" and math.abs(memPosX - part.Position.X) < 0.1 then
                return offset
            end
        end
    end

    return nil
end

function UI:StopFlingBeast()
    if self.flingBeastConnection then
        pcall(function()
            self.flingBeastConnection:Disconnect()
        end)
        pcall(function()
            self.flingBeastConnection:disconnect()
        end)
        self.flingBeastConnection = nil
    end

    local state = self.flingBeastState
    if not state then
        return
    end

    if state.humanoid and state.humanoid.Parent and state.autoRotateOffset and state.originalAutoRotate ~= nil then
        pcall(memory_write, "byte", state.humanoid.Address + state.autoRotateOffset, state.originalAutoRotate)
    end

    if state.localRoot and state.localRoot.Parent then
        pcall(function()
            state.localRoot.Velocity = Vector3.new(0, 0, 0)
        end)
        pcall(function()
            state.localRoot.RotVelocity = Vector3.new(0, 0, 0)
        end)
        if state.originalCFrame then
            state.localRoot.CFrame = state.originalCFrame
        end
    end

    if state.primitiveAddress and state.angVelOffset then
        local targetX = state.primitiveAddress + state.angVelOffset
        local targetY = targetX + 4
        local targetZ = targetX + 8
        pcall(memory_write, "float", targetX, 0)
        pcall(memory_write, "float", targetY, 0)
        pcall(memory_write, "float", targetZ, 0)
    end

    if type(state.collisions) == "table" then
        for part, canCollide in pairs(state.collisions) do
            if part and part.Parent then
                part.CanCollide = canCollide == true
            end
        end
    end

    self.flingBeastState = nil
end

function UI:FlingBeast()
    self:StopFlingBeast()

    local beastModel, beastRoot = self:GetBeastTargetRoot()
    local character = LocalPlayer and LocalPlayer.Character
    local localRoot = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not beastModel or not beastRoot then
        self:NotifyPlayer("Beast not found", "FTF Obsidian", 3)
        return
    end

    if not character or not localRoot or not humanoid or not localRoot.Address or not humanoid.Address then
        self:NotifyPlayer("Local character not ready", "FTF Obsidian", 3)
        return
    end

    local offsets = self:GetFlingOffsets()
    local primitiveOffsets = offsets and offsets.Primitive
    local humanoidOffsets = offsets and offsets.Humanoid
    if type(primitiveOffsets) ~= "table" or type(humanoidOffsets) ~= "table" then
        self:NotifyPlayer("Offsets unavailable", "FTF Obsidian", 3)
        return
    end

    local primitiveOffset = self:GetPrimitivePointerOffset(localRoot, primitiveOffsets.Position)
    if not primitiveOffset then
        self:NotifyPlayer("Primitive offset not found", "FTF Obsidian", 3)
        return
    end
    if type(primitiveOffsets.AssemblyAngularVelocity) ~= "number" or type(humanoidOffsets.AutoRotate) ~= "number" then
        self:NotifyPlayer("Required offsets unavailable", "FTF Obsidian", 3)
        return
    end

    local collisions = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            collisions[part] = part.CanCollide == true
            part.CanCollide = false
        end
    end

    local originalAutoRotate = nil
    pcall(function()
        originalAutoRotate = memory_read("byte", humanoid.Address + humanoidOffsets.AutoRotate)
    end)
    pcall(memory_write, "byte", humanoid.Address + humanoidOffsets.AutoRotate, 0)

    local current = localRoot.CFrame
    local beastPosition = beastRoot.Position
    localRoot.CFrame = CFrame.new(beastPosition.X, beastPosition.Y, beastPosition.Z) * (current - current.Position)

    local startedAt = tick()
    local flingSpeed = 120000
    local angVelOffset = primitiveOffsets.AssemblyAngularVelocity

    self.flingBeastState = {
        localRoot = localRoot,
        humanoid = humanoid,
        originalCFrame = current,
        originalAutoRotate = originalAutoRotate,
        autoRotateOffset = humanoidOffsets.AutoRotate,
        collisions = collisions,
        primitiveAddress = nil,
        angVelOffset = angVelOffset,
    }

    self.flingBeastConnection = RunService.Stepped:Connect(function()
        if humanoid.Health <= 0 or not character:IsDescendantOf(workspace) or not beastRoot.Parent or (tick() - startedAt) >= 2 then
            self:StopFlingBeast()
            return
        end

        local liveCurrent = localRoot.CFrame
        local liveBeastPosition = beastRoot.Position
        localRoot.CFrame = CFrame.new(liveBeastPosition.X, liveBeastPosition.Y, liveBeastPosition.Z) * (liveCurrent - liveCurrent.Position)

        local readOk, livePrimitiveAddress = pcall(memory_read, "uintptr_t", localRoot.Address + primitiveOffset)
        if not readOk or not livePrimitiveAddress or livePrimitiveAddress <= 10000 then
            return
        end
        if self.flingBeastState then
            self.flingBeastState.primitiveAddress = livePrimitiveAddress
        end

        local targetX = livePrimitiveAddress + angVelOffset
        local targetY = targetX + 4
        local targetZ = targetX + 8

        for _ = 1, 2000 do
            memory_write("float", targetX, 0)
            memory_write("float", targetY, flingSpeed)
            memory_write("float", targetZ, 0)
        end
    end)
end

